<script>
document.getElementById("year").textContent=new Date().getFullYear();

const menu=document.getElementById("menu");
const nav=document.getElementById("nav");
menu.addEventListener("click",()=>{
  nav.classList.toggle("open");
  menu.textContent=nav.classList.contains("open")?"×":"☰";
});
nav.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{
  nav.classList.remove("open");menu.textContent="☰";
}));

// Scroll progress and section reveals
window.addEventListener("scroll",()=>{
  const max=document.documentElement.scrollHeight-innerHeight;
  document.getElementById("progress").style.width=
    (max>0?scrollY/max*100:0)+"%";
},{passive:true});

const observer=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add("visible");
      observer.unobserve(e.target);
    }
  });
},{threshold:.12});
document.querySelectorAll(".reveal").forEach(e=>observer.observe(e));

// Desktop custom cursor
const cursor=document.getElementById("cursor");
if(matchMedia("(pointer:fine)").matches){
  window.addEventListener("pointermove",e=>{
    cursor.style.left=e.clientX+"px";
    cursor.style.top=e.clientY+"px";
  },{passive:true});
}

// NGE catalogue manifest.
// A future NGE publishing service can update this file automatically.
async function loadGames(){
  const grid=document.getElementById("gameGrid");
  try{
    const response=await fetch("./games/catalog.json",{cache:"no-store"});
    if(!response.ok)throw new Error("Catalogue not published");
    const data=await response.json();
    const games=Array.isArray(data)?data:data.games;
    if(!Array.isArray(games)||!games.length)throw new Error("No games published");
    grid.replaceChildren();

    games.forEach(game=>{
      const card=document.createElement("article");
      card.className="game";
      if(game.image){
        const img=document.createElement("img");
        img.src=game.image;img.alt=game.name||"NGE game";
        img.loading="lazy";card.append(img);
      }
      const body=document.createElement("div");
      body.className="game-body";
      const title=document.createElement("h3");
      title.textContent=game.name||"Untitled game";
      const description=document.createElement("p");
      description.textContent=game.description||"Created with NGE.";
      body.append(title,description);
      card.append(body);
      if(game.url){
        const link=document.createElement("a");
        link.href=game.url;
        link.target="_blank";
        link.rel="noopener noreferrer";
        link.append(card);grid.append(link);
      }else grid.append(card);
    });
  }catch(error){
    grid.innerHTML="";
    const empty=document.createElement("div");
    empty.className="empty";
    empty.innerHTML="<h3>The NGE universe is expanding.</h3><p>Games will appear here when they are published to the official catalogue.</p>";
    grid.append(empty);
  }
}
loadGames();

// Three.js interactive centerpiece
(async function(){
  const host=document.getElementById("hero3d");
  if(matchMedia("(prefers-reduced-motion: reduce)").matches)return;
  try{
    const THREE=await import(
      "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
    );
    const scene=new THREE.Scene();
    const camera=new THREE.PerspectiveCamera(45,1,.1,100);
    camera.position.set(0,0,9);

    const renderer=new THREE.WebGLRenderer({
      alpha:true,antialias:true,powerPreference:"low-power"
    });
    renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
    renderer.setSize(host.clientWidth,host.clientHeight);
    renderer.setClearColor(0x000000,0);
    host.appendChild(renderer.domElement);

    const core=new THREE.Group();
    scene.add(core);

    const orb=new THREE.Mesh(
      new THREE.IcosahedronGeometry(1.55,2),
      new THREE.MeshStandardMaterial({
        color:0x819dff,metalness:.85,roughness:.2,
        emissive:0x102c66,emissiveIntensity:.6,
        wireframe:false
      })
    );
    core.add(orb);

    const wire=new THREE.Mesh(
      new THREE.IcosahedronGeometry(1.62,2),
      new THREE.MeshBasicMaterial({
        color:0x4de5ff,wireframe:true,transparent:true,opacity:.28
      })
    );
    core.add(wire);

    const ringMaterial=new THREE.MeshStandardMaterial({
      color:0x8dbbff,metalness:.9,roughness:.2,
      emissive:0x1264a8,emissiveIntensity:.5
    });
    const ring=new THREE.Mesh(
      new THREE.TorusGeometry(2.2,.018,12,180),ringMaterial
    );
    ring.rotation.x=1.1;ring.rotation.y=.3;
    core.add(ring);

    const ring2=ring.clone();
    ring2.scale.set(.85,.85,.85);
    ring2.rotation.x=.5;ring2.rotation.y=-.7;
    core.add(ring2);

    const spire=new THREE.Mesh(
      new THREE.ConeGeometry(.42,1.7,6),
      new THREE.MeshStandardMaterial({
        color:0xcbd5e1,metalness:1,roughness:.18,
        emissive:0x163d78,emissiveIntensity:.4
      })
    );
    spire.position.y=2.05;
    core.add(spire);

    scene.add(new THREE.AmbientLight(0x8299cc,2));
    const light=new THREE.PointLight(0x4de5ff,35,15);
    light.position.set(3,3,4);scene.add(light);
    const blueLight=new THREE.PointLight(0x376aff,28,15);
    blueLight.position.set(-4,-2,3);scene.add(blueLight);

    let targetX=0,targetY=0,dragging=false,lastX=0,lastY=0;
    host.addEventListener("pointerdown",e=>{
      dragging=true;lastX=e.clientX;lastY=e.clientY;
      host.setPointerCapture(e.pointerId);
    });
    host.addEventListener("pointerup",()=>dragging=false);
    host.addEventListener("pointercancel",()=>dragging=false);
    host.addEventListener("pointermove",e=>{
      if(dragging){
        targetY+=(e.clientX-lastX)*.008;
      
