
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#050912">
<meta name="description" content="NOVA SPIRE STUDIOS — Building Tomorrow's Technology.">
<title>NOVA SPIRE STUDIOS | Building Tomorrow's Technology</title>

<style>
:root {
  --bg:#050912;
  --panel:#0b1422;
  --blue:#168cff;
  --cyan:#4de5ff;
  --silver:#cbd5e1;
  --text:#f5f8ff;
  --muted:#94a3b8;
  --line:rgba(150,190,255,.17);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--text);
  font-family:Inter,system-ui,Arial,sans-serif;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font:inherit}
#universe{
  position:fixed;inset:0;width:100%;height:100%;
  z-index:-2;pointer-events:none;
}
#cursor{
  position:fixed;width:9px;height:9px;border-radius:50%;
  background:var(--cyan);pointer-events:none;z-index:1000;
  box-shadow:0 0 20px var(--cyan);
  transform:translate(-50%,-50%);
}
@media(pointer:coarse){#cursor{display:none}}

header{
  position:fixed;z-index:100;top:0;width:100%;
  padding:17px 6%;
  display:flex;align-items:center;justify-content:space-between;
  background:#050912c9;backdrop-filter:blur(20px);
  border-bottom:1px solid var(--line);
}
.identity{display:flex;align-items:center;gap:12px}
.logo{
  width:43px;height:43px;border:1px solid var(--cyan);
  border-radius:12px;display:grid;place-items:center;
  color:var(--silver);font-weight:900;font-size:19px;
  box-shadow:0 0 22px #168cff33;
}
.identity strong{font-size:12px;letter-spacing:2px}
.identity small{display:block;font-size:9px;letter-spacing:3px;color:var(--muted);margin-top:4px}
nav{display:flex;align-items:center;gap:25px}
nav a{font-size:11px;letter-spacing:1px;color:var(--muted);transition:.3s}
nav a:hover{color:var(--cyan)}
.menu{
  display:none;color:white;background:none;
  border:1px solid var(--line);padding:8px 12px;border-radius:7px;
}
.eyebrow{
  color:var(--cyan);font-size:10px;
  letter-spacing:4px;text-transform:uppercase;
  margin-bottom:20px;
}
section{padding:110px 8%;position:relative}
.hero{
  min-height:100svh;padding:130px 8% 70px;
  display:flex;align-items:center;overflow:hidden;
}
.hero-content{max-width:780px;position:relative;z-index:2}
.hero h1{
  font-size:clamp(47px,8vw,105px);
  line-height:.96;letter-spacing:-5px;
}
.gradient{
  background:linear-gradient(100deg,#fff,#aeb9d0,#168cff,#4de5ff);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{
  max-width:590px;color:var(--muted);
  line-height:1.9;margin:28px 0 32px;font-size:15px;
}
.actions{display:flex;gap:13px;flex-wrap:wrap}
.btn{
  padding:14px 21px;border-radius:5px;
  border:1px solid var(--line);font-size:10px;
  font-weight:800;letter-spacing:1px;
  display:inline-flex;align-items:center;gap:10px;
  transition:.3s;cursor:pointer;
}
.btn.primary{
  background:linear-gradient(110deg,#168cff,#4de5ff);
  color:#03101d;border:0;
}
.btn:hover{transform:translateY(-4px);box-shadow:0 10px 35px #168cff33}
.hero-hint{
  margin-top:45px;color:#71849e;
  font-size:9px;letter-spacing:2px;
}
#hero3d{
  position:absolute;right:0;top:0;width:62%;
  height:100%;z-index:1;cursor:grab;
}
#hero3d:active{cursor:grabbing}
.hero:after{
  content:"";position:absolute;inset:0;z-index:1;
  background:linear-gradient(90deg,var(--bg) 20%,transparent 85%);
  pointer-events:none;
}
.section-title{max-width:750px;margin-bottom:45px}
.section-title h2{font-size:clamp(32px,5vw,57px);letter-spacing:-2px}
.section-title p{color:var(--muted);line-height:1.9;margin-top:17px;max-width:650px}
.divisions,.products,.features{
  display:grid;grid-template-columns:repeat(3,1fr);gap:17px;
}
.card{
  background:linear-gradient(145deg,#101d30,#080e19);
  border:1px solid var(--line);border-radius:13px;
  padding:27px;position:relative;overflow:hidden;
  transition:.35s;
}
.card:hover{transform:translateY(-7px);border-color:#168cff99}
.symbol{font-size:28px;color:var(--cyan);margin-bottom:22px}
.card h3{font-size:22px;margin-bottom:12px}
.card p{font-size:13px;line-height:1.9;color:var(--muted)}
.card small{
  display:inline-block;margin-top:23px;
  font-size:9px;letter-spacing:2px;color:var(--cyan);
}
.products{grid-template-columns:repeat(3,1fr)}
.product{min-height:205px}
.product h3{font-size:19px}
.product a{display:inline-block;margin-top:17px;font-size:10px;color:var(--cyan)}
.highlight{
  background:radial-gradient(ellipse at center,#0e3760 0%,#081322 60%,#050912);
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
}
.game-shell{
  border:1px solid var(--line);border-radius:15px;
  padding:30px;background:#07111f;
}
.game-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:16px;margin-top:28px;
}
.game{
  background:#0b1828;border:1px solid var(--line);
  border-radius:10px;overflow:hidden;
}
.game img{width:100%;height:145px;object-fit:cover}
.game-body{padding:16px}
.game p{font-size:12px;color:var(--muted);line-height:1.7;margin-top:8px}
.empty{
  grid-column:1/-1;padding:35px;text-align:center;
  border:1px dashed var(--line);border-radius:10px;color:var(--muted);
}
.timeline{display:grid;gap:15px}
.timeline article{
  display:grid;grid-template-columns:65px 1fr;
  gap:20px;padding:20px;border-bottom:1px solid var(--line);
}
.timeline b{color:var(--cyan);font-size:12px}
.timeline p{font-size:13px;color:var(--muted);line-height:1.8;margin-top:7px}
.cta{
  padding:90px 8%;text-align:center;
  background:linear-gradient(120deg,#071b32,#11172c,#071321);
  border-top:1px solid var(--line);
}
.cta h2{font-size:clamp(32px,6vw,66px);letter-spacing:-3px}
.cta p{max-width:550px;margin:20px auto 28px;color:var(--muted);line-height:1.9}
footer{padding:45px 8% 25px;background:#03060c}
.footer-row{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap}
.footer-links{display:flex;gap:18px;flex-wrap:wrap}
.footer-links a,footer p{font-size:11px;color:var(--muted);line-height:2}
.copyright{border-top:1px solid var(--line);margin-top:30px;padding-top:20px;color:#718096;font-size:10px}
.reveal{opacity:0;transform:translateY(22px);transition:.8s}
.reveal.visible{opacity:1;transform:none}
#progress{
  position:fixed;top:0;left:0;width:0;height:2px;
  background:linear-gradient(90deg,var(--blue),var(--cyan));z-index:200;
}
@media(max-width:850px){
  header{padding:14px 5%}
  .menu{display:block}
  nav{
    display:none;position:absolute;top:70px;left:0;
    width:100%;padding:25px;background:#07111f;
    flex-direction:column;border-bottom:1px solid var(--line);
  }
  nav.open{display:flex}
  #hero3d{width:100%;opacity:.55}
  .hero:after{background:linear-gradient(90deg,#050912dd,#05091277)}
  .divisions,.products,.features{grid-template-columns:1fr}
  section{padding:85px 6%}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{scroll-behavior:auto!important;transition:none!important}
  .reveal{opacity:1;transform:none}
}
</style>
</head>

<body>
<div id="progress"></div>
<canvas id="universe"></canvas>
<div id="cursor"></div>

<header>
  <a class="identity" href="#home">
    <div class="logo">NS</div>
    <div>
      <strong>NOVA SPIRE</strong>
      <small>STUDIOS</small>
    </div>
  </a>
  <nav id="nav">
    <a href="#home">HOME</a>
    <a href="#divisions">DIVISIONS</a>
    <a href="#products">ECOSYSTEM</a>
    <a href="#games">GAMES</a>
